# ==============================================================================
# 🥔 감자마켓 환경변수 설정 예시 파일 (.env.example)
# ==============================================================================
# 본 파일을 복사하여 .env 로 이름을 변경한 후, 본인의 Supabase 프로젝트 정보를 입력하세요.
# 주의: 실제 .env 파일은 절대 GitHub 등 공개 저장소에 올리지 마세요!
# ==============================================================================

# 1. Supabase 프로젝트 기본 접속 URL (Dashboard > Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. 브라우저 공개용 익명 API 키 (anon public key)
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. 데이터베이스 관리자 마스터 키 (절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Supabase Personal Access Token (CLI 및 관리용)
SUPABASE_ACCESS_TOKEN=sbp_your_access_token

# 5. Supabase 프로젝트 고유 식별자 (Project Ref)
SUPABASE_PROJECT_ID=your-project-ref
